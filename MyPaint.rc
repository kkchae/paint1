// 문자열

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "그림판"
    AFX_IDS_APP_TITLE       "그림판"
    AFX_IDS_IDLEMESSAGE     "준비"
    ID_IND_POS              "                    "
    ID_IND_SEL              "                    "
    ID_IND_SIZE             "                    "
    ID_IND_ZOOM             "        "
    ID_IND_ZOOMBAR          " "
END

STRINGTABLE
BEGIN
    ID_FILE_NEW             "새 그림을 만듭니다.\n새로 만들기"
    ID_FILE_OPEN            "기존 그림을 엽니다.\n열기"
    ID_FILE_SAVE            "현재 그림을 저장합니다.\n저장"
    ID_FILE_SAVE_AS         "현재 그림을 새 이름으로 저장합니다.\n다른 이름으로 저장"
    ID_APP_EXIT             "그림판을 끝냅니다.\n끝내기"
    ID_APP_ABOUT            "프로그램 정보를 표시합니다.\n정보"
    ID_EDIT_UNDO            "마지막 작업을 취소합니다.\n실행 취소"
    ID_EDIT_REDO            "취소한 작업을 다시 실행합니다.\n다시 실행"
    ID_EDIT_CUT             "선택 영역을 잘라내어 클립보드에 넣습니다.\n잘라내기"
    ID_EDIT_COPY            "선택 영역을 클립보드에 복사합니다.\n복사"
    ID_EDIT_PASTE           "클립보드의 그림을 붙여넣습니다.\n붙여넣기"
    ID_EDIT_SELECT_ALL      "그림 전체를 선택합니다.\n모두 선택"
    ID_EDIT_CLEAR           "선택 영역을 삭제합니다.\n삭제"
    ID_VIEW_STATUS_BAR      "상태 표시줄을 표시하거나 숨깁니다.\n상태 표시줄"
END

STRINGTABLE
BEGIN
    ID_IMAGE_CROP           "그림을 선택 영역으로 자릅니다.\n자르기"
    ID_IMAGE_RESIZE         "그림이나 선택 영역의 크기를 조정하고 기울입니다.\n크기 조정 및 기울이기"
    ID_IMAGE_ROTATE_RIGHT   "오른쪽으로 90도 회전합니다.\n오른쪽으로 회전"
