// 대화 상자

IDD_RESIZE DIALOGEX 0, 0, 222, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "크기 조정 및 기울이기"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "크기 조정",IDC_STATIC,7,7,208,94
    CONTROL         "백분율(&E)",IDC_RB_PERCENT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,18,21,70,10
    CONTROL         "픽셀(&X)",IDC_RB_PIXELS,"Button",BS_AUTORADIOBUTTON,100,21,70,10
    LTEXT           "가로(&H):",IDC_STATIC,18,41,50,8
    EDITTEXT        IDC_EDIT_H,80,39,70,13,ES_NUMBER | ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "세로(&V):",IDC_STATIC,18,60,50,8
    EDITTEXT        IDC_EDIT_V,80,58,70,13,ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "가로 세로 비율 유지(&M)",IDC_CHK_ASPECT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,80,140,10
    GROUPBOX        "기울이기 (도)",IDC_STATIC,7,106,208,62
    LTEXT           "가로(&O):",IDC_STATIC,18,123,50,8
    EDITTEXT        IDC_EDIT_SKEWH,80,121,70,13,ES_AUTOHSCROLL
    LTEXT           "세로(&R):",IDC_STATIC,18,145,50,8
    EDITTEXT        IDC_EDIT_SKEWV,80,143,70,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "확인",IDOK,109,175,50,14
    PUSHBUTTON      "취소",IDCANCEL,165,175,50,14
END

IDD_CANVASSIZE DIALOGEX 0, 0, 200, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "이미지 속성"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "",IDC_STATIC_CUR,10,10,180,9
    GROUPBOX        "캔버스 크기 (픽셀)",IDC_STATIC,7,24,186,52
    LTEXT           "너비(&W):",IDC_STATIC,18,40,50,8
    EDITTEXT        IDC_EDIT_WIDTH,80,38,70,13,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "높이(&H):",IDC_STATIC,18,58,50,8
    EDITTEXT        IDC_EDIT_HEIGHT,80,56,70,13,ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "확인",IDOK,87,83,50,14
    PUSHBUTTON      "취소",IDCANCEL,143,83,50,14
END

IDD_COLLAB_HOST DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "공유 시작 (호스트)"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "다른 그림판이 초대 키로 이 캔버스에 참가해 함께 그릴 수 있습니다.",IDC_STATIC,10,8,240,18
    LTEXT           "내 아이디(&I):",IDC_STATIC,10,34,64,8
    EDITTEXT        IDC_COLLAB_ID,80,32,170,13,ES_AUTOHSCROLL
    LTEXT           "네트워크 주소(&N):",IDC_STATIC,10,54,64,8
    COMBOBOX        IDC_COLLAB_IP,80,52,170,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "포트(&P):",IDC_STATIC,10,74,64,8
    EDITTEXT        IDC_COLLAB_PORT,80,72,50,13,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "포트가 사용 중이면 다음 번호를 자동으로 씁니다. 처음 시작할 때 Windows 방화벽 허용 창이 나타날 수 있습니다.",IDC_STATIC,10,94,240,26
    DEFPUSHBUTTON   "공유 시작",IDOK,146,128,50,14
    PUSHBUTTON      "취소",IDCANCEL,200,128,50,14
END

IDD_COLLAB_JOIN DIALOGEX 0, 0, 260, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "공유 캔버스 참가"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "초대 키(&K):",IDC_STATIC,10,12,60,8
    EDITTEXT        IDC_COLLAB_KEY,74,10,176,13,ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "내 아이디(&I):",IDC_STATIC,10,32,60,8
    EDITTEXT        IDC_COLLAB_ID,74,30,176,13,ES_AUTOHSCROLL
    LTEXT           "참가하면 지금 그림이 호스트의 그림으로 바뀝니다. 다른 참가자와 같은 아이디는 쓸 수 없습니다.",IDC_STATIC,10,52,240,26
    DEFPUSHBUTTON   "참가",IDOK,146,96,50,14
    PUSHBUTTON      "취소",IDCANCEL,200,96,50,14
END

