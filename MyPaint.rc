// MyPaint.rc : resource script (UTF-8, see code_page pragma below)
#include "resource.h"
#include "afxres.h"

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
// 아이콘

IDR_MAINFRAME           ICON                    "res\\MyPaint.ico"

/////////////////////////////////////////////////////////////////////////////
// 메뉴

IDR_MAINFRAME MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",               ID_FILE_NEW
        MENUITEM "열기(&O)...\tCtrl+O",                   ID_FILE_OPEN
        MENUITEM "저장(&S)\tCtrl+S",                      ID_FILE_SAVE
        MENUITEM "다른 이름으로 저장(&A)...\tCtrl+Shift+S", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "이미지 속성(&P)...\tCtrl+E",            ID_IMAGE_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                            ID_APP_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",                 ID_EDIT_UNDO
        MENUITEM "다시 실행(&R)\tCtrl+Y",                 ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",                  ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",                      ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",                  ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A",                 ID_EDIT_SELECT_ALL
        MENUITEM "선택 영역 삭제(&D)\tDel",               ID_EDIT_CLEAR
        MENUITEM "투명 선택(&N)",                         ID_SELECT_TRANSPARENT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\tCtrl+Page Up",                ID_VIEW_ZOOM_IN
        MENUITEM "축소(&O)\tCtrl+Page Down",              ID_VIEW_ZOOM_OUT
        MENUITEM "100%(&1)\tCtrl+1",                      ID_VIEW_ZOOM_100
        MENUITEM "창에 맞추기(&F)\tCtrl+0",               ID_VIEW_ZOOM_FIT
        MENUITEM SEPARATOR
        MENUITEM "눈금자(&R)\tCtrl+R",                    ID_VIEW_RULERS
        MENUITEM "눈금선(&G)\tCtrl+G",                    ID_VIEW_GRID
        MENUITEM "상태 표시줄(&S)",                       ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "다크 모드(&D)",                         ID_VIEW_DARKMODE
    END
    POPUP "이미지(&I)"
    BEGIN
        MENUITEM "자르기(&C)\tCtrl+Shift+X",              ID_IMAGE_CROP
        MENUITEM "크기 조정 및 기울이기(&R)...\tCtrl+W",  ID_IMAGE_RESIZE
        MENUITEM SEPARATOR
        MENUITEM "오른쪽으로 90도 회전",                  ID_IMAGE_ROTATE_RIGHT
        MENUITEM "왼쪽으로 90도 회전",                    ID_IMAGE_ROTATE_LEFT
        MENUITEM "180도 회전",                            ID_IMAGE_ROTATE_180
        MENUITEM "세로로 대칭 이동",                      ID_IMAGE_FLIP_V
        MENUITEM "가로로 대칭 이동",                      ID_IMAGE_FLIP_H
        MENUITEM SEPARATOR
        MENUITEM "색 반전(&I)\tCtrl+Shift+I",             ID_IMAGE_INVERT
        MENUITEM "이미지 지우기(&L)\tCtrl+Shift+N",       ID_IMAGE_CLEAR
        MENUITEM "이미지 속성(&P)...\tCtrl+E",            ID_IMAGE_PROPERTIES
    END
    POPUP "도구(&T)"
    BEGIN
        MENUITEM "사각형 선택(&S)",                       ID_TOOL_SELECT_RECT
        MENUITEM "자유 형식 선택(&F)",                    ID_TOOL_SELECT_FREE
        MENUITEM SEPARATOR
        MENUITEM "연필(&P)",                              ID_TOOL_PENCIL
        MENUITEM "채우기(&B)",                            ID_TOOL_FILL
        MENUITEM "텍스트(&T)",                            ID_TOOL_TEXT
        MENUITEM "지우개(&E)",                            ID_TOOL_ERASER
        MENUITEM "색 선택(&K)",                           ID_TOOL_PICKER
        MENUITEM "돋보기(&M)",                            ID_TOOL_MAGNIFIER
        POPUP "브러시(&R)"
        BEGIN
            MENUITEM "브러시",                            33200
            MENUITEM "캘리그라피 브러시 1",               33201
            MENUITEM "캘리그라피 브러시 2",               33202
            MENUITEM "에어브러시",                        33203
            MENUITEM "유화 브러시",                       33204
            MENUITEM "크레용",                            33205
            MENUITEM "마커",                              33206
            MENUITEM "자연스러운 연필",                   33207
            MENUITEM "수채화 브러시",                     33208
        END
        POPUP "도형(&H)"
        BEGIN
            MENUITEM "선",                                33100
            MENUITEM "곡선",                              33101
            MENUITEM "타원",                              33102
            MENUITEM "사각형",                            33103
            MENUITEM "둥근 사각형",                       33104
            MENUITEM "다각형",                            33105
            MENUITEM "삼각형",                            33106
            MENUITEM "직각 삼각형",                       33107
            MENUITEM "마름모",                            33108
            MENUITEM "오각형",                            33109
            MENUITEM "육각형",                            33110
            MENUITEM "오른쪽 화살표",                     33111
            MENUITEM "왼쪽 화살표",                       33112
            MENUITEM "위쪽 화살표",                       33113
            MENUITEM "아래쪽 화살표",                     33114
            MENUITEM "4각 별",                            33115
            MENUITEM "5각 별",                            33116
            MENUITEM "6각 별",                            33117
            MENUITEM "둥근 사각형 설명선",                33118
            MENUITEM "타원형 설명선",                     33119
            MENUITEM "구름 모양 설명선",                  33120
            MENUITEM "하트",                              33121
            MENUITEM "번개",                              33122
        END
        MENUITEM SEPARATOR
        MENUITEM "굵게(&+)\tCtrl+]",                      ID_SIZE_INC
        MENUITEM "가늘게(&-)\tCtrl+[",                    ID_SIZE_DEC
        MENUITEM SEPARATOR
        MENUITEM "색 편집(&C)...",                        ID_COLOR_EDIT
        MENUITEM "색 1/색 2 바꾸기(&W)\tCtrl+Shift+W",    ID_COLOR_SWAP
    END
    POPUP "공유(&S)"
    BEGIN
        MENUITEM "공유 시작 (호스트)(&H)...",             ID_COLLAB_HOST
        MENUITEM "공유 캔버스 참가(&J)...",               ID_COLLAB_JOIN
        MENUITEM "공유 끝내기 / 나가기(&E)",              ID_COLLAB_LEAVE
        MENUITEM SEPARATOR
        MENUITEM "초대 키 복사(&C)",                      ID_COLLAB_COPYKEY
        MENUITEM "공유 패널 표시(&P)",                    ID_VIEW_CHAT
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "그림판 정보(&A)...",                    ID_APP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// 단축키

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVE_AS,        VIRTKEY, CONTROL, SHIFT, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    "Y",            ID_EDIT_REDO,           VIRTKEY, CONTROL, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    "A",            ID_EDIT_SELECT_ALL,     VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      ID_EDIT_CLEAR,          VIRTKEY, NOINVERT
    "W",            ID_IMAGE_RESIZE,        VIRTKEY, CONTROL, NOINVERT
    "E",            ID_IMAGE_PROPERTIES,    VIRTKEY, CONTROL, NOINVERT
    "X",            ID_IMAGE_CROP,          VIRTKEY, CONTROL, SHIFT, NOINVERT
    "I",            ID_IMAGE_INVERT,        VIRTKEY, CONTROL, SHIFT, NOINVERT
    "N",            ID_IMAGE_CLEAR,         VIRTKEY, CONTROL, SHIFT, NOINVERT
    "W",            ID_COLOR_SWAP,          VIRTKEY, CONTROL, SHIFT, NOINVERT
    "G",            ID_VIEW_GRID,           VIRTKEY, CONTROL, NOINVERT
    "R",            ID_VIEW_RULERS,         VIRTKEY, CONTROL, NOINVERT
    0xDD,           ID_SIZE_INC,            VIRTKEY, CONTROL, NOINVERT
    0xDB,           ID_SIZE_DEC,            VIRTKEY, CONTROL, NOINVERT
    VK_PRIOR,       ID_VIEW_ZOOM_IN,        VIRTKEY, CONTROL, NOINVERT
    VK_NEXT,        ID_VIEW_ZOOM_OUT,       VIRTKEY, CONTROL, NOINVERT
    VK_ADD,         ID_VIEW_ZOOM_IN,        VIRTKEY, CONTROL, NOINVERT
    VK_SUBTRACT,    ID_VIEW_ZOOM_OUT,       VIRTKEY, CONTROL, NOINVERT
    0xBB,           ID_VIEW_ZOOM_IN,        VIRTKEY, CONTROL, NOINVERT
    0xBD,           ID_VIEW_ZOOM_OUT,       VIRTKEY, CONTROL, NOINVERT
    "1",            ID_VIEW_ZOOM_100,       VIRTKEY, CONTROL, NOINVERT
    "0",            ID_VIEW_ZOOM_FIT,       VIRTKEY, CONTROL, NOINVERT
END

